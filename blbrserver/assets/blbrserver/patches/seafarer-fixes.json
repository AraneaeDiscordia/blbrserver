		  "translation": { "x": -0.8, "y": -0.6, "z": -0.6 },
		  "rotation": { "x": 0, "y": -180, "z": 13 },
		  "origin": { "x": 0.5, "y": 0, "z": 0.5 },
		  "scale": 0.8
	  }
  },
