[
  // fix cutlass appearance in toolrack
  {
    "side": "server",
    "dependsOn": [ { "modid": "seafarer" } ],
    "file": "seafarer:itemtypes/tool/cutlass",
    "op": "addMerge",
    "path": "/attributes/toolrackTransformByType",
    "value": {
      "cutlass-*": {
        "translation": {"x": 0.45, "y": 0.5, "z": 0},
        "rotation": {"x": 0, "y": 180, "z": 0}
      }
    }
  },
  // fix waterskin on ground
  {
    "side": "server",
    "dependsOn": [ { "modid": "seafarer" } ],
    "file": "seafarer:blocktypes/leather/waterskin",
    "op": "addMerge",
    "path": "/groundTransform",
    "value": {
      "origin": {"x": 0.5, "y": 0, "z": 0},
      "translation": {"x": -0.1, "y": -0.1, "z": 0},
      "scale": 0.75
    }
  },
  {
    "side": "server",
    "dependsOn": [ { "modid": "seafarer" } ],
    "file": "seafarer:blocktypes/leather/waterskin",
    "op": "addMerge",
    "path": "/attributes/groundStorageTransform",
    "value": {
      "translation": {"x": -0.1, "y": -0.1, "z": 0},
      "scale": 0.75
    }
  },
  // fix waterskin in hand
  {
	  "side": "server",
	  "dependsOn": [ { "modid": "seafarer" } ],
    "file": "seafarer:blocktypes/leather/waterskin",
    "op": "addMerge",
	  "path": "/tpHandTransform",
